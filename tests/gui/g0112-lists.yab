// RenkuBASIC GUI test: list boxes and drop boxes
// Derived from: yab 1.8.3 Examples/AllInOne.yab, GUI-World.yab and
//               MessageWorld.yab.

// @requires: gui-lists
// @timeout: 20

import harness

window open 100, 100 to 420, 340, "rk_list_win", "RenkuBASIC lists"
layout "left, top", "rk_list_win"

// List box.
listbox 10, 10 to 140, 160, "rk_list", 1, "rk_list_win"
listbox add "rk_list", "alpha"
listbox add "rk_list", "beta"
listbox add "rk_list", "gamma"
assert_eq(listbox count "rk_list", 3, "listbox count")
item$ = listbox get$ "rk_list", 2
assert_str$(item$, "beta", "listbox get second item")

listbox select "rk_list", 3
listbox sort "rk_list"
listbox remove "rk_list", 2
assert_eq(listbox count "rk_list", 2, "listbox count after remove")

// Drop box.
dropbox 10, 180 to 140, 204, "rk_drop", "choose", "rk_list_win"
dropbox add "rk_drop", "one"
dropbox add "rk_drop", "two"
dropbox add "rk_drop", "three"
assert_eq(dropbox count "rk_drop", 3, "dropbox count")
item$ = dropbox get$ "rk_drop", 1
assert_str$(item$, "one", "dropbox get first item")

dropbox select "rk_drop", 2
dropbox remove "rk_drop", 3
assert_eq(dropbox count "rk_drop", 2, "dropbox count after remove")
dropbox clear "rk_drop"
assert_eq(dropbox count "rk_drop", 0, "dropbox clear")

// Clearing a list box works as well.
listbox clear "rk_list"
assert_eq(listbox count "rk_list", 0, "listbox clear")

sleep 0.1
window close "rk_list_win"
print "g0112 done"
exit 0
