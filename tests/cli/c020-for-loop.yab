// RenkuBASIC CLI test: for / next / step
// Derived from: yabasic 2.92.1 tests/for.yab

import harness

// Fractional bounds: the loop variable ends one step past the limit.
for i = 0.2 to 5
  last = i
next i
assert_near(last, 4.2, 1e-9, "last fractional iteration")
assert_near(i, 5.2, 1e-9, "loop variable after fractional loop")

// Negative bounds.
for i = -5 to 5
  count = count + 1
next i
assert_eq(count, 11, "inclusive bounds")
assert_eq(i, 6, "loop variable after integer loop")

// Nested loops.
k = 0
for i = 1 to 2
  for j = 2 to 4
    k = k + 1
  next j
next i
assert_eq(k, 6, "nested for loops")

// Step.
total = 0
for i = 10 to 1 step -3
  total = total + i
next i
assert_eq(total, 22, "negative step")   // 10 + 7 + 4 + 1

// Step with fractions.
n = 0
for i = 0 to 1 step 0.25
  n = n + 1
next i
assert_eq(n, 5, "fractional step")

// The loop body may execute zero times.
n = 0
for i = 5 to 1
  n = n + 1
next i
assert_eq(n, 0, "empty for loop")

// break and continue inside for.
n = 0
for i = 1 to 10
  if i = 3 continue
  if i = 6 break
  n = n + 1
next i
assert_eq(n, 4, "continue and break in for")   // 1,2,4,5

print "c020 done"
exit 0
