// RenkuBASIC CLI test: yab compatibility peeks
//
// yab 1.8.3 (Examples/Version.yab) uses peeks that yabasic 2.92.1 does not
// have. RenkuBASIC must provide the string peeks now; the yab widget and file
// extensions (peek("numwindows"), peek("scrollbarwidth"), bfilesize(),
// bfiledirexists()) arrive with the yab compatibility layer in phase 3 and
// are tested then.
//
// @requires: renkubasic

import harness

// yab programs print the working directory.
assert_true(len(peek$("directory")) > 0, "peek$('directory')")

// Absolute paths start with '/' on Haiku.
assert_true(left$(peek$("directory"), 1) = "/", "peek$('directory') is absolute")

// yab reports the interpreter version through peek$("version"); the language
// level is unchanged, so yab's own version check keeps working.
assert_true(len(peek$("version")) > 0, "peek$('version')")

// RenkuOS/Haiku names for OS detection, added in phase 1 (decision Q3).
assert_true(peek$("os") = "haiku" or peek$("os") = "renkuos", "peek$('os')")
assert_eq(peek$("yabos"), "Haiku", "peek$('yabos')")

print "c083 done"
exit 0
