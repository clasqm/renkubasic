// RenkuBASIC CLI test: base 2 and base 16 literals and conversions
// Derived from: yabasic 2.92.1 tests/hex_bin.yab and the "Numbers with base 2
//               or 16" chapter of the manual.

import harness

// Literals.
assert_eq(0x10, 16, "hex literal")
assert_eq(0xff, 255, "hex literal ff")
assert_eq(0b1010, 10, "binary literal")
assert_eq(0b11111111, 255, "binary literal eight bits")

// Conversion to string.
assert_str$(hex$(255), "ff", "hex$(255)")
assert_str$(hex$(16), "10", "hex$(16)")
assert_str$(bin$(5), "101", "bin$(5)")
assert_str$(bin$(255), "11111111", "bin$(255)")

// Conversion back.
assert_eq(dec("ff", 16), 255, "dec(hex)")
assert_eq(dec("101", 2), 5, "dec(binary)")
// With one argument dec() reads base 16 (as in yabasic 2.92.1).
assert_eq(dec("10"), 16, "dec with one argument reads hex")

// Round trip.
assert_eq(dec(hex$(1234), 16), 1234, "hex round trip")
assert_eq(dec(bin$(1234), 2), 1234, "bin round trip")

// case insensitivity of hex digits.
assert_eq(dec("FF", 16), 255, "upper case hex digits")
assert_eq(dec("fF", 16), 255, "mixed case hex digits")

print "c041 done"
exit 0
