// RenkuBASIC CLI test: arrays
// Derived from: yabasic 2.92.1 tests/array.yab and the dim/arraysize chapters
//               of the yabasic 2.92.1 manual.

import harness

// Two dimensional array, default bounds 1..
dim a(5, 5)
for x = 0 to 5 : for y = 0 to 5
  a(x, y) = 1
next y : next x

// Re-dimensioning keeps the cells that exist in both sizes and zero fills the
// new ones; the 36 ones set above therefore survive (this is the behaviour
// yabasic 2.92.1 tests/array.yab pins down).
dim a(7, 7)
sum = 0
for x = 0 to 7 : for y = 0 to 7
  sum = sum + a(x, y)
next y : next x
assert_eq(sum, 36, "dim keeps the overlapping cells")

// Bounds and dimensions.
dim b(3, 4, 5)
assert_eq(arraysize(b(), 1), 3, "arraysize dimension 1")
assert_eq(arraysize(b(), 2), 4, "arraysize dimension 2")
assert_eq(arraysize(b(), 3), 5, "arraysize dimension 3")
assert_eq(arraydim(b()), 3, "arraydim")

// One dimensional string array.
dim names$(3)
names$(1) = "a" : names$(2) = "b" : names$(3) = "c"
assert_str$(names$(2), "b", "string array element")
assert_eq(arraysize(names$(), 1), 3, "string array size")

// Arrays are zero filled on creation.
dim c(10)
assert_eq(c(7), 0, "numeric array is zero filled")

// Element expressions and nested indexing.
dim d(2)
i = 1
d(i + 1) = 4
assert_eq(d(2), 4, "computed index")

// redim is a synonym for dim.
dim e(4)
e(2) = 9
redim e(6)
assert_eq(e(2), 9, "redim keeps the overlapping cells")

print "c030 done"
exit 0
